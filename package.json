{
  "name": "zipcheckup-agent",
  "version": "0.1.0",
  "private": false,
  "description": "US home environmental risk data exposed as WebMCP tools an AI agent can call directly, with source, measurement date and an explicit unknown for every missing value.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "serve": "npx --yes serve web -l 4173",
    "build:data": "node scripts/build-data.mjs",
    "verify:data": "node scripts/verify-data.mjs",
    "vendor:polyfill": "node scripts/vendor-polyfill.mjs",
    "test": "node --test test/",
    "smoke": "node scripts/smoke.mjs",
    "deploy": "npx --yes wrangler pages deploy web --project-name=zipcheckup-agent"
  }
}
